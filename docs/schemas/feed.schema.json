{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feed.schema.json",
  "$defs": {
    "FeedEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Тип события для бейджа: название главного маркера",
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/Marker"
          },
          "title": "Markers",
          "type": "array"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/Topic"
          },
          "title": "Topics",
          "type": "array"
        },
        "sentiment": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "negative",
                "neutral",
                "mixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentiment"
        },
        "horizon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Horizon"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "polarity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Polarity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Риск или возможность для компании: по оценке влияния"
        }
      },
      "required": [
        "type"
      ],
      "title": "FeedEvent",
      "type": "object"
    },
    "FeedFeature": {
      "additionalProperties": false,
      "description": "Признак компании, из-за которого новость попала в ленту: для «почему это для вас».",
      "properties": {
        "feature_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "label": {
          "description": "Формулировка признака из профиля",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "description": "Как новость связана с этим признаком",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Правило отбора или llm — сослалась модель",
          "title": "Rule"
        },
        "contribution": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Вклад признака в итоговый балл",
          "title": "Contribution"
        }
      },
      "required": [
        "feature_id",
        "label",
        "reason"
      ],
      "title": "FeedFeature",
      "type": "object"
    },
    "FeedItem": {
      "additionalProperties": false,
      "description": "Материал ленты компании: карточка, тип события, балл и объяснение релевантности.",
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "news_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "News Id",
          "type": "string"
        },
        "story_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Сюжет, если событие пишут несколько изданий",
          "title": "Story Id"
        },
        "kind": {
          "$ref": "#/$defs/MaterialKind",
          "description": "bank_analytics — позиция Альфа-Банка, news — внешняя новость"
        },
        "card": {
          "$ref": "#/$defs/NewsCard"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "coverage": {
          "description": "Сколько изданий пишут о событии",
          "minimum": 1,
          "title": "Coverage",
          "type": "integer"
        },
        "event": {
          "$ref": "#/$defs/FeedEvent"
        },
        "stage": {
          "$ref": "#/$defs/RankStage",
          "description": "reranked — релевантность подтвердила модель"
        },
        "significance": {
          "$ref": "#/$defs/Significance",
          "description": "Из уровня важности: критично и важно — high"
        },
        "importance": {
          "$ref": "#/$defs/Importance",
          "description": "Балл 0–10, уровень и вклад каждого фактора"
        },
        "impact": {
          "$ref": "#/$defs/ImpactAssessment",
          "description": "Влияние на бизнес от −100 до +100: цвет, критерии и обоснование"
        },
        "score": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "explanation": {
          "description": "Почему эта новость для вас: аргумент модели или правил",
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/FeedFeature"
          },
          "title": "Features",
          "type": "array"
        }
      },
      "required": [
        "rank",
        "news_id",
        "kind",
        "card",
        "coverage",
        "event",
        "stage",
        "significance",
        "importance",
        "impact",
        "score",
        "explanation"
      ],
      "title": "FeedItem",
      "type": "object"
    },
    "FeedRejection": {
      "additionalProperties": false,
      "properties": {
        "news_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "News Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "reason": {
          "description": "Аргумент модели, почему новость не касается компании",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "news_id",
        "title",
        "reason"
      ],
      "title": "FeedRejection",
      "type": "object"
    },
    "Horizon": {
      "enum": [
        "days",
        "weeks",
        "months",
        "years"
      ],
      "title": "Horizon",
      "type": "string"
    },
    "ImpactAnswer": {
      "additionalProperties": false,
      "description": "Ответ на один из общих вопросов о том, через что событие доходит до бизнеса компании.",
      "properties": {
        "question_id": {
          "description": "Идентификатор вопроса, например costs.suppliers",
          "maxLength": 200,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "question": {
          "description": "Вопрос словами для сводки по клику",
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "criterion": {
          "$ref": "#/$defs/ImpactCriterionId"
        },
        "level": {
          "description": "−2 существенно хуже … +2 существенно лучше",
          "maximum": 2,
          "minimum": -2,
          "title": "Level",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactTiming"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timing_title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timing Title"
        },
        "timing_source": {
          "anyOf": [
            {
              "enum": [
                "source",
                "estimate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timing Source"
        }
      },
      "required": [
        "question_id",
        "question",
        "criterion",
        "level",
        "reason"
      ],
      "title": "ImpactAnswer",
      "type": "object"
    },
    "ImpactAssessment": {
      "additionalProperties": false,
      "description": "Оценка влияния события на бизнес компании: балл от −100 до +100, цвет и обоснование.\nБалл равен сумме вкладов критериев, ограниченной ±100.",
      "properties": {
        "score": {
          "maximum": 100,
          "minimum": -100,
          "title": "Score",
          "type": "integer"
        },
        "color": {
          "$ref": "#/$defs/ImpactColor"
        },
        "title": {
          "description": "Сильный риск, Риск, Нейтрально, Возможность, Сильная возможность",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "criteria": {
          "description": "Все критерии оценки; в сохранённых до расширения оценках их пять",
          "items": {
            "$ref": "#/$defs/ImpactCriterion"
          },
          "maxItems": 9,
          "minItems": 5,
          "title": "Criteria",
          "type": "array"
        },
        "rationale": {
          "description": "Обоснование балла для карточки",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "method": {
          "description": "llm — оценила модель с учётом профиля, rules — запасная оценка по теме",
          "enum": [
            "llm",
            "rules"
          ],
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "answers": {
          "description": "Вопросы с влиянием; уровень критерия — самый сильный ответ его группы",
          "items": {
            "$ref": "#/$defs/ImpactAnswer"
          },
          "maxItems": 50,
          "title": "Answers",
          "type": "array"
        }
      },
      "required": [
        "score",
        "color",
        "title",
        "criteria",
        "rationale",
        "method",
        "confidence"
      ],
      "title": "ImpactAssessment",
      "type": "object"
    },
    "ImpactBand": {
      "additionalProperties": false,
      "description": "Цветовая зона шкалы влияния для легенды в интерфейсе.",
      "properties": {
        "color": {
          "$ref": "#/$defs/ImpactColor"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "min_score": {
          "maximum": 100,
          "minimum": -100,
          "title": "Min Score",
          "type": "integer"
        },
        "max_score": {
          "maximum": 100,
          "minimum": -100,
          "title": "Max Score",
          "type": "integer"
        },
        "hex": {
          "minLength": 1,
          "pattern": "^#[0-9A-F]{6}$",
          "title": "Hex",
          "type": "string"
        }
      },
      "required": [
        "color",
        "title",
        "min_score",
        "max_score",
        "hex"
      ],
      "title": "ImpactBand",
      "type": "object"
    },
    "ImpactColor": {
      "enum": [
        "red",
        "orange",
        "gray",
        "light_green",
        "green"
      ],
      "title": "ImpactColor",
      "type": "string"
    },
    "ImpactCriterion": {
      "additionalProperties": false,
      "description": "Влияние события на один фиксированный критерий: уровень от −2 до +2 и почему.\nПлюс — лучше для компании: для регуляторного риска плюс значит, что риск снижается.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ImpactCriterionId"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "level": {
          "description": "−2 существенно хуже … +2 существенно лучше",
          "maximum": 2,
          "minimum": -2,
          "title": "Level",
          "type": "integer"
        },
        "points": {
          "description": "Вклад в балл: ±20 — заметно, ±50 — существенно",
          "maximum": 50,
          "minimum": -50,
          "title": "Points",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Почему такой уровень; пусто при 0",
          "title": "Reason"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactTiming"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Когда скажется на компании"
        },
        "timing_title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Срок словами для карточки",
          "title": "Timing Title"
        },
        "timing_source": {
          "anyOf": [
            {
              "enum": [
                "source",
                "estimate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source — срок назван в материале, estimate — оценка ИИ",
          "title": "Timing Source"
        }
      },
      "required": [
        "id",
        "title",
        "level",
        "points"
      ],
      "title": "ImpactCriterion",
      "type": "object"
    },
    "ImpactCriterionId": {
      "enum": [
        "revenue",
        "costs",
        "market_access",
        "cost_of_money",
        "regulatory",
        "liquidity",
        "fx",
        "counterparties",
        "competition"
      ],
      "title": "ImpactCriterionId",
      "type": "string"
    },
    "ImpactCriterionInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ImpactCriterionId"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ],
      "title": "ImpactCriterionInfo",
      "type": "object"
    },
    "ImpactTiming": {
      "enum": [
        "now",
        "quarter",
        "year",
        "later"
      ],
      "title": "ImpactTiming",
      "type": "string"
    },
    "Importance": {
      "additionalProperties": false,
      "description": "Степень важности материала для компании: 0–10, уровень и вклад каждого фактора.\nСумма points всех факторов равна score.",
      "properties": {
        "score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/ImportanceLevel"
        },
        "title": {
          "description": "Критично, Важно, К сведению, Фон",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/ImportanceFactor"
          },
          "minItems": 1,
          "title": "Factors",
          "type": "array"
        }
      },
      "required": [
        "score",
        "level",
        "title",
        "factors"
      ],
      "title": "Importance",
      "type": "object"
    },
    "ImportanceFactor": {
      "additionalProperties": false,
      "description": "Слагаемое балла важности: сколько баллов дал фактор и почему.",
      "properties": {
        "id": {
          "description": "relevance, breadth, scale, recency, model, bank",
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "points": {
          "maximum": 10,
          "minimum": 0,
          "title": "Points",
          "type": "number"
        },
        "max_points": {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Max Points",
          "type": "number"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "points",
        "max_points",
        "detail"
      ],
      "title": "ImportanceFactor",
      "type": "object"
    },
    "ImportanceLevel": {
      "enum": [
        "critical",
        "important",
        "info",
        "background"
      ],
      "title": "ImportanceLevel",
      "type": "string"
    },
    "ImportanceScale": {
      "additionalProperties": false,
      "description": "Критерий уровня для пользователя: с какого балла и что это значит.",
      "properties": {
        "level": {
          "$ref": "#/$defs/ImportanceLevel"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "min_score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Min Score",
          "type": "number"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "level",
        "title",
        "min_score",
        "description"
      ],
      "title": "ImportanceScale",
      "type": "object"
    },
    "Marker": {
      "description": "Маркер новости для фильтров ленты. Список закрыт: модель выбирает из него, а не\nпридумывает свои.",
      "enum": [
        "economy_rate",
        "fx",
        "regulation_taxes",
        "trade_duties",
        "commodities_prices",
        "logistics",
        "labor",
        "technology",
        "industry_event",
        "incident"
      ],
      "title": "Marker",
      "type": "string"
    },
    "MaterialKind": {
      "enum": [
        "news",
        "bank_analytics"
      ],
      "title": "MaterialKind",
      "type": "string"
    },
    "NewsCard": {
      "additionalProperties": false,
      "description": "Карточка оригинала: издание, дата, ссылка на статью и картинка, если она есть.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "news_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "News Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source": {
          "description": "Издание",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Статья в первоисточнике",
          "title": "Url"
        },
        "image": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Картинка статьи; null — показывать placeholder",
          "title": "Image"
        },
        "placeholder": {
          "$ref": "#/$defs/Placeholder"
        }
      },
      "required": [
        "news_id",
        "title",
        "source",
        "published_at",
        "placeholder"
      ],
      "title": "NewsCard",
      "type": "object"
    },
    "Placeholder": {
      "additionalProperties": false,
      "description": "Чем заполнить место картинки, если её нет: карточка не должна менять вёрстку.",
      "properties": {
        "initials": {
          "description": "Буквы издания: «РГ», «И»",
          "minLength": 1,
          "title": "Initials",
          "type": "string"
        },
        "domain": {
          "description": "Домен статьи: vedomosti.ru",
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "color": {
          "description": "Цвет фона, постоянный у издания",
          "minLength": 1,
          "pattern": "^#[0-9A-F]{6}$",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "initials",
        "domain",
        "color"
      ],
      "title": "Placeholder",
      "type": "object"
    },
    "Polarity": {
      "enum": [
        "risk",
        "opportunity",
        "neutral"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "RankStage": {
      "enum": [
        "candidate",
        "reranked"
      ],
      "title": "RankStage",
      "type": "string"
    },
    "RoleAdjustment": {
      "additionalProperties": false,
      "properties": {
        "id": {
