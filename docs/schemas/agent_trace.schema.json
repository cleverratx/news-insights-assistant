{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_trace.schema.json",
  "$defs": {
    "AllowedModel": {
      "enum": [
        "gemma-4-26b-a4b",
        "glm-5.3-flash",
        "qwen3.6-35b-a3b",
        "deepseek-v4.1-flash",
        "qwen3-vl-30b-a3b-instruct",
        "kimi-k2.6"
      ],
      "title": "AllowedModel",
      "type": "string"
    },
    "Basis": {
      "additionalProperties": false,
      "description": "Фрагмент документа или признак компании, из которого получено утверждение.",
      "properties": {
        "source_id": {
          "description": "SourceRef.id внутри вывода",
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "ref_id": {
          "description": "NewsItem.id или ProfileFeature.id",
          "maxLength": 200,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "fragment_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fragment.id или KeyFact.id",
          "title": "Fragment Id"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Дословная выдержка из фрагмента",
          "title": "Quote"
        }
      },
      "required": [
        "source_id",
        "type",
        "ref_id"
      ],
      "title": "Basis",
      "type": "object"
    },
    "CheckIssue": {
      "additionalProperties": false,
      "properties": {
        "statement_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement Id"
        },
        "problem": {
          "$ref": "#/$defs/CheckProblem"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "problem",
        "detail",
        "resolved"
      ],
      "title": "CheckIssue",
      "type": "object"
    },
    "CheckProblem": {
      "enum": [
        "unsupported",
        "contradiction",
        "not_personal",
        "trivial",
        "other"
      ],
      "title": "CheckProblem",
      "type": "string"
    },
    "ContextObservation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "step_number": {
          "minimum": 1,
          "title": "Step Number",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "tool",
        "arguments",
        "observation",
        "step_number"
      ],
      "title": "ContextObservation",
      "type": "object"
    },
    "CriticReport": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "semantic_checked": {
          "title": "Semantic Checked",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/CheckIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "suggested_tools": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Suggested Tools",
          "type": "array"
        },
        "cost_rub": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cost Rub"
        },
        "unavailable": {
          "default": false,
          "title": "Unavailable",
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "semantic_checked"
      ],
      "title": "CriticReport",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "completed",
        "step_limit",
        "timeout",
        "planner_error",
        "check_failed",
        "unavailable"
      ],
      "type": "string"
    },
    "FeatureKind": {
      "enum": [
        "industry",
        "scale",
        "finance",
        "product",
        "region",
        "foreign_trade",
        "group",
        "counterparty",
        "ownership",
        "lifecycle",
        "knowledge",
        "competitor"
      ],
      "title": "FeatureKind",
      "type": "string"
    },
    "GenerationUsage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "default": 0,
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "known_cost_rub": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Known Cost Rub"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/AllowedModel"
          },
          "title": "Models",
          "type": "array"
        },
        "pricing_modes": {
          "items": {
            "enum": [
              "configured",
              "public_estimate"
            ],
            "type": "string"
          },
          "title": "Pricing Modes",
          "type": "array"
        }
      },
      "title": "GenerationUsage",
      "type": "object"
    },
    "ImpactAnswer": {
      "additionalProperties": false,
      "description": "Ответ на один из общих вопросов о том, через что событие доходит до бизнеса компании.",
      "properties": {
        "question_id": {
          "description": "Идентификатор вопроса, например costs.suppliers",
          "maxLength": 200,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "question": {
          "description": "Вопрос словами для сводки по клику",
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "criterion": {
          "$ref": "#/$defs/ImpactCriterionId"
        },
        "level": {
          "description": "−2 существенно хуже … +2 существенно лучше",
          "maximum": 2,
          "minimum": -2,
          "title": "Level",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactTiming"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timing_title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timing Title"
        },
        "timing_source": {
          "anyOf": [
            {
              "enum": [
                "source",
                "estimate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timing Source"
        },
        "points": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": -100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Вклад ответа в итог (scale=weighted): сила с учётом срока и того, подтверждён ли канал данными компании",
          "title": "Points"
        },
        "features": {
          "description": "Признаки компании, через которые канал у неё есть; пусто — канал данными компании не подтверждён",
          "items": {
            "$ref": "#/$defs/ImpactFeature"
          },
          "title": "Features",
          "type": "array"
        }
      },
      "required": [
        "question_id",
        "question",
        "criterion",
        "level",
        "reason"
      ],
      "title": "ImpactAnswer",
      "type": "object"
    },
    "ImpactAssessment": {
      "additionalProperties": false,
      "description": "Оценка влияния события на бизнес компании: балл от −100 до +100, цвет и обоснование.\nБалл равен сумме вкладов критериев, ограниченной ±100; при scale=weighted — разнице\nвозможностей и рисков.",
      "properties": {
        "score": {
          "maximum": 100,
          "minimum": -100,
          "title": "Score",
          "type": "integer"
        },
        "color": {
          "$ref": "#/$defs/ImpactColor"
        },
        "title": {
          "description": "Сильный риск, Риск, Нейтрально, Возможность, Сильная возможность; Двоякое влияние — плюсы и минусы в сумме дали ноль",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "criteria": {
          "description": "Все критерии оценки; в сохранённых до расширения оценках их пять",
          "items": {
            "$ref": "#/$defs/ImpactCriterion"
          },
          "maxItems": 9,
          "minItems": 5,
          "title": "Criteria",
          "type": "array"
        },
        "rationale": {
          "description": "Обоснование балла для карточки",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "method": {
          "description": "llm — оценила модель с учётом профиля, rules — запасная оценка по теме",
          "enum": [
            "llm",
            "rules"
          ],
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "answers": {
          "description": "Вопросы с влиянием: уровень от −2 до +2 и вклад в итог",
          "items": {
            "$ref": "#/$defs/ImpactAnswer"
          },
          "maxItems": 50,
          "title": "Answers",
          "type": "array"
        },
        "scale": {
          "default": "points",
          "description": "weighted — вклад ответа зависит от уровня, срока и подтверждения данными компании, риски и возможности накапливаются с насыщением до 100; levels и points — прежние подсчёты у сохранённых раньше оценок",
          "enum": [
            "weighted",
            "levels",
            "points"
          ],
          "title": "Scale",
          "type": "string"
        },
        "risk": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Сила рисков 0–100 (scale=weighted)",
          "title": "Risk"
        },
        "opportunity": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Сила возможностей 0–100 (scale=weighted)",
          "title": "Opportunity"
        }
      },
      "required": [
        "score",
        "color",
        "title",
        "criteria",
        "rationale",
        "method",
        "confidence"
      ],
      "title": "ImpactAssessment",
      "type": "object"
    },
    "ImpactColor": {
      "enum": [
        "red",
        "orange",
        "gray",
        "light_green",
        "green"
      ],
      "title": "ImpactColor",
      "type": "string"
    },
    "ImpactCriterion": {
      "additionalProperties": false,
      "description": "Влияние события на один фиксированный критерий: уровень от −2 до +2 и почему.\nПлюс — лучше для компании: для регуляторного риска плюс значит, что риск снижается.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ImpactCriterionId"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "level": {
          "description": "−2 существенно хуже … +2 существенно лучше",
          "maximum": 2,
          "minimum": -2,
          "title": "Level",
          "type": "integer"
        },
        "points": {
          "description": "Вклад в итог: сумма уровней ответов группы (scale=levels) или ±20/±50 в оценках до перехода на сумму (scale=points)",
          "maximum": 100,
          "minimum": -100,
          "title": "Points",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Почему такой уровень; пусто при 0",
          "title": "Reason"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactTiming"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Когда скажется на компании"
        },
        "timing_title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Срок словами для карточки",
          "title": "Timing Title"
        },
        "timing_source": {
          "anyOf": [
            {
              "enum": [
                "source",
                "estimate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source — срок назван в материале, estimate — оценка ИИ",
          "title": "Timing Source"
        }
      },
      "required": [
        "id",
        "title",
        "level",
        "points"
      ],
      "title": "ImpactCriterion",
      "type": "object"
    },
    "ImpactCriterionId": {
      "enum": [
        "revenue",
        "costs",
        "market_access",
        "cost_of_money",
        "regulatory",
        "liquidity",
        "fx",
        "counterparties",
        "competition"
      ],
      "title": "ImpactCriterionId",
      "type": "string"
    },
    "ImpactFeature": {
      "additionalProperties": false,
      "description": "Признак компании, через который канал влияния у неё есть: кредиты, импорт, контрагент.",
      "properties": {
        "id": {
          "description": "ProfileFeature.id",
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ImpactFeature",
      "type": "object"
    },
    "ImpactTiming": {
      "enum": [
        "now",
        "quarter",
        "year",
        "later"
      ],
      "title": "ImpactTiming",
      "type": "string"
    },
    "Importance": {
      "additionalProperties": false,
      "description": "Степень важности материала для компании: 0–10, уровень и вклад каждого фактора.\nСумма points всех факторов равна score.",
      "properties": {
        "score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/ImportanceLevel"
        },
        "title": {
          "description": "Критично, Важно, К сведению, Фон",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/ImportanceFactor"
          },
          "minItems": 1,
          "title": "Factors",
          "type": "array"
        }
      },
      "required": [
        "score",
        "level",
        "title",
        "factors"
      ],
      "title": "Importance",
      "type": "object"
    },
    "ImportanceFactor": {
      "additionalProperties": false,
      "description": "Слагаемое балла важности: сколько баллов дал фактор и почему.",
      "properties": {
        "id": {
          "description": "relevance, breadth, scale, recency, model, bank",
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "points": {
          "maximum": 10,
          "minimum": 0,
          "title": "Points",
          "type": "number"
        },
        "max_points": {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Max Points",
          "type": "number"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "points",
        "max_points",
        "detail"
      ],
      "title": "ImportanceFactor",
      "type": "object"
    },
    "ImportanceLevel": {
      "enum": [
        "critical",
        "important",
        "info",
        "background"
      ],
      "title": "ImportanceLevel",
      "type": "string"
    },
    "InsightRanking": {
      "additionalProperties": false,
      "properties": {
        "news_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "News Id",
          "type": "string"
        },
        "score": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "significance": {
          "$ref": "#/$defs/Significance"
        },
        "importance": {
          "$ref": "#/$defs/Importance"
        },
        "impact": {
          "$ref": "#/$defs/ImpactAssessment"
        }
      },
      "required": [
        "news_id",
        "score",
        "significance",
        "importance",
        "impact"
      ],
      "title": "InsightRanking",
      "type": "object"
    },
    "JsonValue": {},
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "source_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "title": "Observation",
      "type": "object"
    },
    "Origin": {
      "enum": [
        "fact",
        "bank",
        "client_data",
        "model"
      ],
      "title": "Origin",
      "type": "string"
    },
    "ProfileFeature": {
      "additionalProperties": false,
      "description": "Признак компании, на который может сослаться вывод.",
      "properties": {
        "id": {
          "description": "Идентификатор признака внутри профиля, например feature:loan",
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FeatureKind"
        },
        "label": {
          "description": "Формулировка для человека: «есть кредитные продукты»",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "source_fields": {
          "description": "Поля выгрузки, из которых получен признак",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Fields",
          "type": "array"
        },
        "derived": {
          "default": false,
          "description": "Признак вычислен (ранг, доля), а не взят из поля как есть",
          "title": "Derived",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "source_fields"
      ],
      "title": "ProfileFeature",
      "type": "object"
    },
    "RoleAdjustment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "multiplier": {
          "maximum": 2,
          "minimum": 0.2,
          "title": "Multiplier",
          "type": "number"
        },
        "company_relevance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Company Relevance",
          "type": "number"
        },
        "role_relevance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Role Relevance",
          "type": "number"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
