{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insight_draft.schema.json",
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "description": "fact — подтверждено источником, bank — позиция Альфа-Банка, client_data — из данных о компании, model — вывод модели"
        },
        "source_ids": {
          "description": "Ссылки на SourceRef.id",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "basis": {
          "description": "Заполняет сервер: фрагменты документов и признаки, подтверждающие текст",
          "items": {
            "$ref": "#/$defs/Basis"
          },
          "title": "Basis",
          "type": "array"
        },
        "support": {
          "anyOf": [
            {
              "$ref": "#/$defs/Support"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Заполняет сервер: source — подтверждено фрагментом документа, company_data — данными компании, assumption — подтверждения нет, это предположение модели"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "product": {
          "anyOf": [
            {
              "$ref": "#/$defs/BankProduct"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "text",
        "origin",
        "source_ids",
        "kind"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionKind": {
      "enum": [
        "action",
        "question",
        "scenario",
        "bank_product"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "BankProduct": {
      "enum": [
        "settlement",
        "guarantee",
        "loan",
        "leasing",
        "deposit",
        "payroll",
        "factoring"
      ],
      "title": "BankProduct",
      "type": "string"
    },
    "Basis": {
      "additionalProperties": false,
      "description": "Фрагмент документа или признак компании, из которого получено утверждение.",
      "properties": {
        "source_id": {
          "description": "SourceRef.id внутри вывода",
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "ref_id": {
          "description": "NewsItem.id или ProfileFeature.id",
          "maxLength": 200,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "fragment_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fragment.id или KeyFact.id",
          "title": "Fragment Id"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Дословная выдержка из фрагмента",
          "title": "Quote"
        }
      },
      "required": [
        "source_id",
        "type",
        "ref_id"
      ],
      "title": "Basis",
      "type": "object"
    },
    "Impact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "description": "fact — подтверждено источником, bank — позиция Альфа-Банка, client_data — из данных о компании, model — вывод модели"
        },
        "source_ids": {
          "description": "Ссылки на SourceRef.id",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "basis": {
          "description": "Заполняет сервер: фрагменты документов и признаки, подтверждающие текст",
          "items": {
            "$ref": "#/$defs/Basis"
          },
          "title": "Basis",
          "type": "array"
        },
        "support": {
          "anyOf": [
            {
              "$ref": "#/$defs/Support"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Заполняет сервер: source — подтверждено фрагментом документа, company_data — данными компании, assumption — подтверждения нет, это предположение модели"
        },
        "horizon": {
          "anyOf": [
            {
              "enum": [
                "short",
                "medium",
                "long"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon"
        },
        "magnitude": {
          "anyOf": [
            {
              "$ref": "#/$defs/Significance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "text",
        "origin",
        "source_ids"
      ],
      "title": "Impact",
      "type": "object"
    },
    "Origin": {
      "enum": [
        "fact",
        "bank",
        "client_data",
        "model"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Significance": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Significance",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Первоисточник, на который ссылаются утверждения вывода.",
      "properties": {
        "id": {
          "description": "Локальный идентификатор внутри вывода, например s1",
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "ref_id": {
          "description": "NewsItem.id или ProfileFeature.id",
          "maxLength": 200,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "fragment_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fragment.id или KeyFact.id",
          "title": "Fragment Id"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        }
      },
      "required": [
        "id",
        "type",
        "ref_id",
        "title"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "news",
        "bank_analytics",
        "profile_feature"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "Statement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "description": "fact — подтверждено источником, bank — позиция Альфа-Банка, client_data — из данных о компании, model — вывод модели"
        },
        "source_ids": {
          "description": "Ссылки на SourceRef.id",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "basis": {
          "description": "Заполняет сервер: фрагменты документов и признаки, подтверждающие текст",
          "items": {
            "$ref": "#/$defs/Basis"
          },
          "title": "Basis",
          "type": "array"
        },
        "support": {
          "anyOf": [
            {
              "$ref": "#/$defs/Support"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Заполняет сервер: source — подтверждено фрагментом документа, company_data — данными компании, assumption — подтверждения нет, это предположение модели"
        }
      },
      "required": [
        "id",
        "text",
        "origin",
        "source_ids"
      ],
      "title": "Statement",
      "type": "object"
    },
    "Support": {
      "enum": [
        "source",
        "company_data",
        "assumption"
      ],
      "title": "Support",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "headline": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Headline"
    },
    "company_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Company Id",
      "type": "string"
    },
    "news_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "News Ids",
      "type": "array"
    },
    "what_happened": {
      "items": {
        "$ref": "#/$defs/Statement"
      },
      "maxItems": 50,
      "title": "What Happened",
      "type": "array"
    },
    "why_it_matters": {
      "items": {
        "$ref": "#/$defs/Statement"
      },
      "maxItems": 50,
      "title": "Why It Matters",
      "type": "array"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/Impact"
      },
      "maxItems": 50,
      "title": "Risks",
      "type": "array"
    },
    "opportunities": {
      "items": {
        "$ref": "#/$defs/Impact"
      },
      "maxItems": 50,
      "title": "Opportunities",
      "type": "array"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "maxItems": 50,
      "title": "Actions",
      "type": "array"
    },
    "bank_view": {
      "items": {
        "$ref": "#/$defs/Statement"
      },
      "maxItems": 50,
      "title": "Bank View",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 50,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "company_id",
    "news_ids"
  ],
  "title": "Draft",
  "type": "object"
}
