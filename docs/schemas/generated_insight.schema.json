{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated_insight.schema.json",
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "description": "fact — подтверждено источником, bank — позиция Альфа-Банка, client_data — из данных о компании, model — вывод модели"
        },
        "source_ids": {
          "description": "Ссылки на SourceRef.id",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "basis": {
          "description": "Заполняет сервер: фрагменты документов и признаки, подтверждающие текст",
          "items": {
            "$ref": "#/$defs/Basis"
          },
          "title": "Basis",
          "type": "array"
        },
        "support": {
          "anyOf": [
            {
              "$ref": "#/$defs/Support"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Заполняет сервер: source — подтверждено фрагментом документа, company_data — данными компании, assumption — подтверждения нет, это предположение модели"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "product": {
          "anyOf": [
            {
              "$ref": "#/$defs/BankProduct"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "text",
        "origin",
        "source_ids",
        "kind"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionKind": {
      "enum": [
        "action",
        "question",
        "scenario",
        "bank_product"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "AllowedModel": {
      "enum": [
        "gemma-4-26b-a4b",
        "glm-5.3-flash",
        "qwen3.6-35b-a3b",
        "deepseek-v4.1-flash",
        "qwen3-vl-30b-a3b-instruct",
        "kimi-k2.6"
      ],
      "title": "AllowedModel",
      "type": "string"
    },
    "BankProduct": {
      "enum": [
        "settlement",
        "guarantee",
        "loan",
        "leasing",
        "deposit",
        "payroll",
        "factoring"
      ],
      "title": "BankProduct",
      "type": "string"
    },
    "Basis": {
      "additionalProperties": false,
      "description": "Фрагмент документа или признак компании, из которого получено утверждение.",
      "properties": {
        "source_id": {
          "description": "SourceRef.id внутри вывода",
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "ref_id": {
          "description": "NewsItem.id или ProfileFeature.id",
          "maxLength": 200,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "fragment_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fragment.id или KeyFact.id",
          "title": "Fragment Id"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Дословная выдержка из фрагмента",
          "title": "Quote"
        }
      },
      "required": [
        "source_id",
        "type",
        "ref_id"
      ],
      "title": "Basis",
      "type": "object"
    },
    "BlockId": {
      "enum": [
        "event",
        "relevance",
        "consequences",
        "actions",
        "bank",
        "basis"
      ],
      "type": "string"
    },
    "CheckIssue": {
      "additionalProperties": false,
      "properties": {
        "statement_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement Id"
        },
        "problem": {
          "$ref": "#/$defs/CheckProblem"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "problem",
        "detail",
        "resolved"
      ],
      "title": "CheckIssue",
      "type": "object"
    },
    "CheckProblem": {
      "enum": [
        "unsupported",
        "contradiction",
        "not_personal",
        "trivial",
        "other"
      ],
      "title": "CheckProblem",
      "type": "string"
    },
    "CompanyMention": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "relationship": {
          "enum": [
            "competitor",
            "counterparty"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "origins": {
          "items": {
            "$ref": "#/$defs/LinkOrigin"
          },
          "title": "Origins",
          "type": "array"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/CounterpartyRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "enum": [
            "entity",
            "text"
          ],
          "title": "Method",
          "type": "string"
        },
        "evidence": {
          "description": "Название сущности или фрагмент исходного текста",
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "news_id": {
          "description": "Публикация, в которой найдено упоминание",
          "maxLength": 200,
          "minLength": 1,
          "title": "News Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "relationship",
        "method",
        "evidence",
        "news_id"
      ],
      "title": "CompanyMention",
      "type": "object"
    },
    "CounterpartyRole": {
      "enum": [
        "buyer",
        "supplier",
        "carrier"
      ],
      "title": "CounterpartyRole",
      "type": "string"
    },
    "DataGap": {
      "additionalProperties": false,
      "description": "Чего не хватило для вывода и что из-за этого не показано или показано с оговоркой.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/GapKind"
        },
        "missing": {
          "description": "Чего не хватает — словами для пользователя",
          "minLength": 1,
          "title": "Missing",
          "type": "string"
        },
        "consequence": {
          "description": "Что из-за этого не сделано или сделано с оговоркой",
          "minLength": 1,
          "title": "Consequence",
          "type": "string"
        },
        "remedy": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Как восполнить пробел",
          "title": "Remedy"
        },
        "blocking": {
          "description": "Из-за пробела персональный вывод не сформирован",
          "title": "Blocking",
          "type": "boolean"
        },
        "details": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Details",
          "type": "array"
        },
        "question_keys": {
          "description": "Вопросы базы знаний компании, закрывающие пробел",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Question Keys",
          "type": "array"
        },
        "news_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "News Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "missing",
        "consequence",
        "blocking"
      ],
      "title": "DataGap",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "completed",
        "step_limit",
        "timeout",
        "planner_error",
        "check_failed",
        "unavailable"
      ],
      "type": "string"
    },
    "GapKind": {
      "enum": [
        "model",
        "verification",
        "numbers",
        "bank_view",
        "source_text",
        "company_data"
      ],
      "title": "GapKind",
      "type": "string"
    },
    "GenerationUsage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "default": 0,
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "prompt_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "known_cost_rub": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Known Cost Rub"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/AllowedModel"
          },
          "title": "Models",
          "type": "array"
        },
        "pricing_modes": {
          "items": {
            "enum": [
              "configured",
              "public_estimate"
            ],
            "type": "string"
          },
          "title": "Pricing Modes",
          "type": "array"
        }
      },
      "title": "GenerationUsage",
      "type": "object"
    },
    "Impact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "description": "fact — подтверждено источником, bank — позиция Альфа-Банка, client_data — из данных о компании, model — вывод модели"
        },
        "source_ids": {
          "description": "Ссылки на SourceRef.id",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "basis": {
          "description": "Заполняет сервер: фрагменты документов и признаки, подтверждающие текст",
          "items": {
            "$ref": "#/$defs/Basis"
          },
          "title": "Basis",
          "type": "array"
        },
        "support": {
          "anyOf": [
            {
              "$ref": "#/$defs/Support"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Заполняет сервер: source — подтверждено фрагментом документа, company_data — данными компании, assumption — подтверждения нет, это предположение модели"
        },
        "horizon": {
          "anyOf": [
            {
              "enum": [
                "short",
                "medium",
                "long"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon"
        },
        "magnitude": {
          "anyOf": [
            {
              "$ref": "#/$defs/Significance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "text",
        "origin",
        "source_ids"
      ],
      "title": "Impact",
      "type": "object"
    },
    "ImpactAssessment": {
      "additionalProperties": false,
      "description": "Оценка влияния события на бизнес компании: балл от −100 до +100, цвет и обоснование.\nБалл равен сумме вкладов критериев, ограниченной ±100.",
      "properties": {
        "score": {
          "maximum": 100,
          "minimum": -100,
          "title": "Score",
          "type": "integer"
        },
        "color": {
          "$ref": "#/$defs/ImpactColor"
        },
        "title": {
          "description": "Сильный риск, Риск, Нейтрально, Возможность, Сильная возможность",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "criteria": {
          "description": "Все критерии оценки; в сохранённых до расширения оценках их пять",
          "items": {
            "$ref": "#/$defs/ImpactCriterion"
          },
          "maxItems": 9,
          "minItems": 5,
          "title": "Criteria",
          "type": "array"
        },
        "rationale": {
          "description": "Обоснование балла для карточки",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "method": {
          "description": "llm — оценила модель с учётом профиля, rules — запасная оценка по теме",
          "enum": [
            "llm",
            "rules"
          ],
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "score",
        "color",
        "title",
        "criteria",
        "rationale",
        "method",
        "confidence"
      ],
      "title": "ImpactAssessment",
      "type": "object"
    },
    "ImpactColor": {
      "enum": [
        "red",
        "orange",
        "gray",
        "light_green",
        "green"
      ],
      "title": "ImpactColor",
      "type": "string"
    },
    "ImpactCriterion": {
      "additionalProperties": false,
      "description": "Влияние события на один фиксированный критерий: уровень от −2 до +2 и почему.\nПлюс — лучше для компании: для регуляторного риска плюс значит, что риск снижается.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ImpactCriterionId"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "level": {
          "description": "−2 существенно хуже … +2 существенно лучше",
          "maximum": 2,
          "minimum": -2,
          "title": "Level",
          "type": "integer"
        },
        "points": {
          "description": "Вклад в балл: ±20 — заметно, ±50 — существенно",
          "maximum": 50,
          "minimum": -50,
          "title": "Points",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Почему такой уровень; пусто при 0",
          "title": "Reason"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactTiming"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Когда скажется на компании"
        },
        "timing_title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Срок словами для карточки",
          "title": "Timing Title"
        },
        "timing_source": {
          "anyOf": [
            {
              "enum": [
                "source",
                "estimate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "source — срок назван в материале, estimate — оценка ИИ",
          "title": "Timing Source"
        }
      },
      "required": [
        "id",
        "title",
        "level",
        "points"
      ],
      "title": "ImpactCriterion",
      "type": "object"
    },
    "ImpactCriterionId": {
      "enum": [
        "revenue",
        "costs",
        "market_access",
        "cost_of_money",
        "regulatory",
        "liquidity",
        "fx",
        "counterparties",
        "competition"
      ],
      "title": "ImpactCriterionId",
      "type": "string"
    },
    "ImpactTiming": {
      "enum": [
        "now",
        "quarter",
        "year",
        "later"
      ],
      "title": "ImpactTiming",
      "type": "string"
    },
    "Importance": {
      "additionalProperties": false,
      "description": "Степень важности материала для компании: 0–10, уровень и вклад каждого фактора.\nСумма points всех факторов равна score.",
      "properties": {
        "score": {
          "maximum": 10,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/ImportanceLevel"
        },
        "title": {
          "description": "Критично, Важно, К сведению, Фон",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/ImportanceFactor"
          },
          "minItems": 1,
          "title": "Factors",
          "type": "array"
        }
      },
      "required": [
        "score",
        "level",
        "title",
        "factors"
      ],
      "title": "Importance",
      "type": "object"
    },
    "ImportanceFactor": {
      "additionalProperties": false,
      "description": "Слагаемое балла важности: сколько баллов дал фактор и почему.",
      "properties": {
        "id": {
          "description": "relevance, breadth, scale, recency, model, bank",
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "points": {
          "maximum": 10,
          "minimum": 0,
          "title": "Points",
          "type": "number"
        },
        "max_points": {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Max Points",
          "type": "number"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "points",
        "max_points",
        "detail"
      ],
      "title": "ImportanceFactor",
      "type": "object"
    },
    "ImportanceLevel": {
      "enum": [
        "critical",
        "important",
        "info",
        "background"
      ],
      "title": "ImportanceLevel",
      "type": "string"
    },
    "Insight": {
      "additionalProperties": false,
      "description": "Персональная интерпретация события: ответ на шесть вопросов кейса.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "company_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "news_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "News Ids",
          "type": "array"
        },
        "run_id": {
          "description": "Идентификатор разбора для трассировки шагов агента",
          "maxLength": 200,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/InsightStatus"
        },
        "status_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Почему вывод не готов; обязательно, если status не ready",
          "title": "Status Reason"
        },
        "headline": {
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "significance": {
          "$ref": "#/$defs/Significance"
