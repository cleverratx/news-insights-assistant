{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_response.schema.json",
  "$defs": {
    "JsonValue": {},
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "source_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "title": "Observation",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_decision",
            "unknown_tool",
            "invalid_arguments",
            "invalid_result",
            "tool_error",
            "tool_timeout"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Path",
          "type": "array"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "type"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "observation": {
            "type": "null"
          },
          "error": {
            "type": "string"
          },
          "error_detail": {
            "type": "object"
          }
        },
        "required": [
          "error",
          "error_detail"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "type": "object"
          },
          "error": {
            "type": "null"
          },
          "error_detail": {
            "type": "null"
          }
        },
        "required": [
          "observation"
        ]
      }
    }
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "error",
        "timeout"
      ],
      "title": "Status",
      "type": "string"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Observation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "error_detail": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "status"
  ],
  "title": "ToolResponse",
  "type": "object"
}
