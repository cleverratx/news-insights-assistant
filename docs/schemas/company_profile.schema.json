{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company_profile.schema.json",
  "$defs": {
    "BankProduct": {
      "enum": [
        "settlement",
        "guarantee",
        "loan",
        "leasing",
        "deposit",
        "payroll",
        "factoring"
      ],
      "title": "BankProduct",
      "type": "string"
    },
    "ClientType": {
      "enum": [
        "client",
        "close_client",
        "prospect"
      ],
      "title": "ClientType",
      "type": "string"
    },
    "CompanyGroup": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "companies_count": {
          "minimum": 1,
          "title": "Companies Count",
          "type": "integer"
        },
        "industries": {
          "description": "Сегменты рынка компаний группы, от частых к редким",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Industries",
          "type": "array"
        },
        "members": {
          "description": "Крупнейшие по выручке компании группы, кроме клиента",
          "items": {
            "$ref": "#/$defs/RelatedCompany"
          },
          "title": "Members",
          "type": "array"
        }
      },
      "required": [
        "group_id",
        "companies_count"
      ],
      "title": "CompanyGroup",
      "type": "object"
    },
    "Counterparty": {
      "additionalProperties": false,
      "properties": {
        "company_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "direction": {
          "description": "incoming — компания получает деньги от контрагента, outgoing — платит ему",
          "enum": [
            "incoming",
            "outgoing"
          ],
          "title": "Direction",
          "type": "string"
        },
        "amount_rub": {
          "minimum": 0,
          "title": "Amount Rub",
          "type": "number"
        },
        "payments_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payments Count"
        },
        "share": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Доля в платежах этого направления",
          "title": "Share"
        },
        "okved_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Okved Name"
        },
        "segment": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Сегмент рынка из справочника ОКВЭД",
          "title": "Segment"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "required": [
        "company_id",
        "direction",
        "amount_rub"
      ],
      "title": "Counterparty",
      "type": "object"
    },
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "missing_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "warnings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "DataQuality",
      "type": "object"
    },
    "Exposure": {
      "additionalProperties": false,
      "description": "Чем компании грозит или полезна тема новостей и из-за каких её признаков.",
      "properties": {
        "topic": {
          "$ref": "#/$defs/Topic"
        },
        "direction": {
          "$ref": "#/$defs/ExposureDirection"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "feature_ids": {
          "description": "Ссылки на ProfileFeature.id",
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Feature Ids",
          "type": "array"
        },
        "keywords": {
          "description": "Термины для поиска новостей по этой теме у компании",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "required": [
        "topic",
        "direction",
        "reason",
        "feature_ids"
      ],
      "title": "Exposure",
      "type": "object"
    },
    "ExposureDirection": {
      "enum": [
        "risk",
        "opportunity",
        "mixed"
      ],
      "title": "ExposureDirection",
      "type": "string"
    },
    "FeatureKind": {
      "enum": [
        "industry",
        "scale",
        "finance",
        "product",
        "region",
        "foreign_trade",
        "group",
        "counterparty",
        "ownership",
        "lifecycle"
      ],
      "title": "FeatureKind",
      "type": "string"
    },
    "ForeignTrade": {
      "additionalProperties": false,
      "properties": {
        "has_customs_records": {
          "title": "Has Customs Records",
          "type": "boolean"
        },
        "countries": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Countries",
          "type": "array"
        }
      },
      "required": [
        "has_customs_records"
      ],
      "title": "ForeignTrade",
      "type": "object"
    },
    "Industry": {
      "additionalProperties": false,
      "properties": {
        "okved_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Okved Code"
        },
        "okved_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Okved Name"
        },
        "section": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Раздел ОКВЭД, буква от A до U",
          "title": "Section"
        },
        "segment": {
          "default": "other",
          "description": "Укрупнённый сегмент рынка из справочника",
          "maxLength": 200,
          "minLength": 1,
          "title": "Segment",
          "type": "string"
        },
        "segment_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Name"
        },
        "value_chain": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueChain"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Место в цепочке: добыча, производство, опт, розница, услуги"
        },
        "resolved_by": {
          "$ref": "#/$defs/IndustryResolution",
          "default": "unknown",
          "description": "code — по коду ОКВЭД, name — код битый и отрасль угадана по названию"
        },
        "topics": {
          "description": "Темы новостей, к которым чувствителен сегмент",
          "items": {
            "$ref": "#/$defs/Topic"
          },
          "title": "Topics",
          "type": "array"
        },
        "keywords": {
          "description": "Отраслевые термины для расширения поискового запроса",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "title": "Industry",
      "type": "object"
    },
    "IndustryResolution": {
      "enum": [
        "code",
        "name",
        "unknown"
      ],
      "title": "IndustryResolution",
      "type": "string"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "MarketPosition": {
      "additionalProperties": false,
      "description": "Оценка положения среди компаний той же отрасли в выгрузке, а не доля рынка страны.",
      "properties": {
        "peer_basis": {
          "enum": [
            "okved_code",
            "okved_group"
          ],
          "title": "Peer Basis",
          "type": "string"
        },
        "peer_count": {
          "minimum": 1,
          "title": "Peer Count",
          "type": "integer"
        },
        "revenue_rank": {
          "minimum": 1,
          "title": "Revenue Rank",
          "type": "integer"
        },
        "revenue_percentile": {
          "maximum": 1,
          "minimum": 0,
          "title": "Revenue Percentile",
          "type": "number"
        },
        "peer_revenue_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Peer Revenue Share",
          "type": "number"
        }
      },
      "required": [
        "peer_basis",
        "peer_count",
        "revenue_rank",
        "revenue_percentile",
        "peer_revenue_share"
      ],
      "title": "MarketPosition",
      "type": "object"
    },
    "ProfileFeature": {
      "additionalProperties": false,
      "description": "Признак компании, на который может сослаться вывод.",
      "properties": {
        "id": {
          "description": "Идентификатор признака внутри профиля, например feature:loan",
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FeatureKind"
        },
        "label": {
          "description": "Формулировка для человека: «есть кредитные продукты»",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "source_fields": {
          "description": "Поля выгрузки, из которых получен признак",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Fields",
          "type": "array"
        },
        "derived": {
          "default": false,
          "description": "Признак вычислен (ранг, доля), а не взят из поля как есть",
          "title": "Derived",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "source_fields"
      ],
      "title": "ProfileFeature",
      "type": "object"
    },
    "RelatedCompany": {
      "additionalProperties": false,
      "description": "Компания, связанная с клиентом через группу или общее физлицо.",
      "properties": {
        "company_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Company Id",
          "type": "string"
        },
        "relation": {
          "enum": [
            "group",
            "shared_person"
          ],
          "title": "Relation",
          "type": "string"
        },
        "okved_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Okved Name"
        },
        "segment": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Сегмент рынка из справочника ОКВЭД",
          "title": "Segment"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "revenue_rub": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revenue Rub"
        }
      },
      "required": [
        "company_id",
        "relation"
      ],
      "title": "RelatedCompany",
      "type": "object"
    },
    "Scale": {
      "additionalProperties": false,
      "properties": {
        "revenue_rub": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revenue Rub"
        },
        "size_category": {
          "anyOf": [
            {
              "$ref": "#/$defs/SizeCategory"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "По выручке: до 120 млн — micro, до 800 млн — small, до 2 млрд — medium (пороги МСП), от 15 млрд — largest (порог кейса), между ними — large"
        },
        "employees_band": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employees Band"
        },
        "age_band": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Band"
        },
        "lifecycle_stage": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ECO_MARK_LABEL",
          "title": "Lifecycle Stage"
        },
        "is_large_business": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Выручка от 15 млрд рублей — порог из кейса; пусто, если выручки нет",
          "title": "Is Large Business"
        }
      },
      "title": "Scale",
      "type": "object"
    },
    "SizeCategory": {
      "enum": [
        "micro",
        "small",
        "medium",
        "large",
        "largest"
      ],
      "title": "SizeCategory",
      "type": "string"
    },
    "Topic": {
      "enum": [
        "key_rate",
        "inflation",
        "fx",
        "commodities",
        "trade",
        "sanctions",
        "regulation",
        "taxes",
        "labor",
        "consumption",
        "debt_market",
        "macro",
        "industry",
        "regional",
        "company",
        "other"
      ],
      "title": "Topic",
      "type": "string"
    },
    "ValueChain": {
      "enum": [
        "extraction",
        "manufacturing",
        "utilities",
        "construction",
        "wholesale",
        "retail",
        "services"
      ],
      "title": "ValueChain",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Бизнес-контекст компании, собранный по выгрузкам кейса.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "company_id": {
      "description": "SYNTHETIC_U",
      "maxLength": 200,
      "minLength": 1,
      "title": "Company Id",
      "type": "string"
    },
    "client_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClientType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ownership": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ownership"
    },
    "industry": {
      "$ref": "#/$defs/Industry"
    },
    "scale": {
      "$ref": "#/$defs/Scale"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/BankProduct"
      },
      "title": "Products",
      "type": "array"
    },
    "foreign_trade": {
      "$ref": "#/$defs/ForeignTrade"
    },
    "group": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompanyGroup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "counterparties": {
      "items": {
        "$ref": "#/$defs/Counterparty"
      },
      "title": "Counterparties",
      "type": "array"
    },
    "linked_persons_count": {
      "default": 0,
      "minimum": 0,
      "title": "Linked Persons Count",
      "type": "integer"
    },
    "person_regions": {
      "description": "Регионы связанных физлиц (RC_NAME), без повторов",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Person Regions",
      "type": "array"
    },
    "related_companies": {
      "description": "Компании, связанные через общих физлиц",
      "items": {
        "$ref": "#/$defs/RelatedCompany"
      },
      "title": "Related Companies",
      "type": "array"
    },
    "has_key_owner_mark": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "NEGATIVEMARK",
      "title": "Has Key Owner Mark"
    },
    "market_position": {
      "anyOf": [
        {
          "$ref": "#/$defs/MarketPosition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "features": {
      "description": "Пусто, если в строке выгрузки нечего взять",
      "items": {
        "$ref": "#/$defs/ProfileFeature"
      },
      "title": "Features",
      "type": "array"
    },
    "exposures": {
      "items": {
        "$ref": "#/$defs/Exposure"
      },
      "title": "Exposures",
      "type": "array"
    },
    "data_quality": {
      "$ref": "#/$defs/DataQuality"
    }
  },
  "required": [
    "company_id",
    "industry",
    "scale",
    "location",
    "foreign_trade"
  ],
  "title": "CompanyProfile",
  "type": "object"
}
