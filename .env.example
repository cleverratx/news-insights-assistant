APP_ENV=local
APP_PORT=8000
LOG_LEVEL=info
WEB_PORT=8080

POSTGRES_DB=alfa
POSTGRES_USER=alfa
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://alfa:change-me@postgres:5432/alfa

REDIS_URL=redis://redis:6379/0

LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=
LLM_MODEL_FAST=deepseek-v4.1-flash
LLM_MODEL_SMART=glm-5.3-flash
LLM_MODELS={}
LLM_PRICING_MODE=public_estimate
LLM_ESTIMATE_USD_RUB=100
LLM_ESTIMATE_SAFETY_MULTIPLIER=2
LLM_DAILY_BUDGET_RUB=500
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.5
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_INPUT_BYTES=24000
LLM_BUDGET_TIMEZONE=UTC

NEWS_SOURCES_FILE=app/news/sources.yaml
NEWS_FETCH_INTERVAL_MINUTES=30
NEWS_USER_AGENT=alfa-news-insights/0.1

DATA_DIR=/app/data
LEGEND_FILE=samples/legends.yaml
ANALYTICS_DIR=raw/analytics
OCR_COMMAND=tesseract
OCR_LANGUAGES=rus+eng
